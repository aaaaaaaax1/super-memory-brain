# Super Memory Brain Git safety guardrails
# This package is the direct Git working tree. Track implementation only;
# never stage local memory, machine state, or generated output.

# Local memory and state
private-state/**
private-archive/**

# Canonical implementation tree. CORE is public source; only its local
# runtime-layout file is machine-specific.
.stage10-public-root/

# memory is a compatibility junction into private-state. Only the vendored
# runtime scripts remain public; every mutable memory body stays ignored.
memory/**
!memory/
CORE/memory/**
!CORE/memory/

# Local install markers and machine-local policy
package-root.txt
memory-root.txt
.memory-scope.json
memory-sharing-policy.json
CORE/runtime-layout.json

# Generated caches
__pycache__/
*.pyc
CORE/ui/node_modules/
CORE/ui/.vite/
CORE/ui/.playwright-cli/
CORE/.tmp-smoke-test/

# Local editor and agent state
.codex/
.agents/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local environment overrides.  Keep documented examples publishable.
.env.*
!.env.example
!.env.*.example
.envrc

# Machine-local Windows shortcuts
*.lnk

# Backups and generated releases
install-backup-*/
super-memory-brain-package-private*/
super-memory-brain-package-release-v*/

# Secrets and key material
.env
*.env
*.secret
*.key
*.pem
*.pfx

# Logs and local status snapshots
*.log
memory/workspace/last-*.json
memory/workspace/last-*.log

# Local runtime and generated material
CORE/runtime/state/workspace/**
CORE/output/**
CORE/.playwright-cli/**
CORE/runtime/*.local-runtime-backup-*
