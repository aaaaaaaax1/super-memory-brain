      "cannotDo": ["store secrets/noise/raw long chat by default", "override current visible instructions"],
      "triggers": ["\u7ee7\u7eed", "\u4e0a\u6b21", "\u8bb0\u4f4f", "\u4efb\u52a1\u72b6\u6001", "\u8d85\u7ea7\u5927\u8111", "\u53e6\u4e00\u4e2a\u4f1a\u8bdd"],
