{
  "schema": "super-brain.skill-capability-map.v1",
  "source": "package_public_seed",
  "guard": "Skills are internal capabilities selected by ORC as execution constraints, executors, references, verifiers, cache/version guards, or coordinators; use rules_as_execution_constraints_not_menu_calls and do not leave them as user-remembered menu items.",
  "mode": "rules_as_execution_constraints_not_menu_calls",
  "capabilities": [
    {
      "name": "ponytail",
      "category": "rule",
      "role": "pre_action_constraint",
      "canDo": ["anti-overengineering", "minimal safe diff", "delete/stdlib/native/existing dependency first"],
      "cannotDo": ["remove validation/privacy/error handling/tests/rollback/user requirements"],
      "triggers": ["code edit", "bug fix", "script change", "refactor", "dependency choice", "optimize", "feature"],
      "applyAt": ["preflight", "before_mutation", "route_review"],
      "verification": ["diff is smallest safe change", "no speculative scaffolding"],
      "stopCondition": "larger structure is explicitly required by requirements, security, migration, performance, or accepted architecture"
    },
    {
      "name": "grill-me",
      "category": "rule",
      "role": "challenge_gate",
      "canDo": ["challenge assumptions", "surface non-goals", "find counterexamples", "force acceptance evidence"],
      "cannotDo": ["replace local evidence exploration", "ask broad questions when code can answer"],
      "triggers": ["plan", "architecture", "multi-step", "unclear requirements", "completion criteria", "\u9a8c\u6536", "\u65b9\u6848"],
      "applyAt": ["preflight", "before_plan_commit", "before_completion"],
      "verification": ["requirements/non-goals challenged", "acceptance evidence named"],
      "stopCondition": "task is tiny, fully specified, and low risk"
    },
    {
      "name": "review / chinese-code-review",
      "category": "rule",
      "role": "review_verifier",
      "canDo": ["find correctness, maintainability, security and regression risks", "produce evidence-backed review findings"],
      "cannotDo": ["replace tests", "approve unevidenced completion"],
      "triggers": ["review", "PR", "risk", "\u5b8c\u6210\u524d", "\u4ee3\u7801\u5ba1\u67e5", "completion audit"],
      "applyAt": ["before_completion", "after_mutation"],
      "verification": ["review findings resolved or explicitly accepted", "completion audit includes review/verifier role"]
    },
    {
      "name": "tdd / vitest / testing-setup",
      "category": "verification",
      "role": "test_strategy",
      "canDo": ["define regression tests", "run JS/TS test workflows", "protect behavior"],
      "cannotDo": ["prove untested user-facing paths"],
      "triggers": ["test", "regression", "bug", "feature", "CI", "verify", "completion audit"],
      "applyAt": ["planning", "implementation", "verification", "before_completion"],
      "verification": ["targeted tests pass", "failure mode covered"]
    },
    {
      "name": "integration-parity-check / browser-act / emulator/simulator",
      "category": "verification",
      "role": "real_user_path_verifier",
      "canDo": ["separate module smoke, integration smoke, and user-facing acceptance", "require concrete command/log/screenshot/UI path/actual output evidence", "route browser/mobile/device paths to appropriate tool skills"],
      "cannotDo": ["treat unit/module smoke as user acceptance", "accept vague success claims without concrete evidence"],
      "triggers": ["real user path", "user-facing", "acceptance", "\u9a8c\u6536", "UI path", "screenshot", "actual output", "completion audit", "verify"],
      "applyAt": ["verification", "before_completion", "acceptance"],
      "verification": ["realUserPathVerification flag true", "concrete acceptance evidence present", "module/integration/user acceptance layers remain separate"],
      "stopCondition": "not applicable only for purely internal/docs-only changes, and the reason must be recorded"
    },
    {
      "name": "version-bump / changelog / baseline history",
      "category": "release_state",
      "role": "version_record_keeper",
      "canDo": ["update manifest version", "record changelog and CURRENT_BASELINE", "preserve rollback notes through BASELINE_HISTORY and graph lineage"],
      "cannotDo": ["claim release/version completion with stale version files", "skip changelog for package behavior changes"],
      "triggers": ["version", "changelog", "baseline", "release", "package update", "completion audit"],
      "applyAt": ["after_mutation", "before_completion", "release_readiness"],
      "verification": ["manifest/CHANGELOG/CURRENT_BASELINE versions match", "version-bump preview/apply evidence or manual equivalent recorded"]
    },
    {
      "name": "host-cache-check / hot-refresh-skills",
      "category": "startup_cache",
      "role": "cache_freshness_checker",
      "canDo": ["detect installed skill copy freshness", "surface current-session loaded-skill cache limitation", "recommend hot refresh plus new session when needed"],
      "cannotDo": ["inspect already-loaded chat-session skill text", "pretend hot-refresh updates the current in-memory skill body"],
      "triggers": ["cache", "host cache", "hot refresh", "installed skill", "new session", "startup", "completion audit"],
      "applyAt": ["after_mutation", "before_completion", "startup_verification"],
      "verification": ["last-host-cache-check.json reports installedFresh or staleHosts", "user-facing cache hint present when session may be stale"]
    },
    {
      "name": "current-task-context / goal-route-lock / route-checkpoint",
      "category": "guard_state",
      "role": "current_task_guard",
      "canDo": ["bind guard scripts to one current taskId", "detect stale checkedAt/version-mismatched context", "prevent global last-* evidence from satisfying a different task"],
      "cannotDo": ["reuse cleared/stale task context as proof", "let unscoped global state pass completion"],
      "triggers": ["current task", "task context", "stale", "route", "guard", "completion audit"],
      "applyAt": ["preflight", "before_mutation", "before_completion"],
      "verification": ["current-task-context Status ok=true and stale=false", "TaskId passed into route/causal/integration/task-verification/completion-guard scripts"]
    },
    {
      "name": "reflection-promotion / skill-evolution-loop / lesson-scope-gate",
      "category": "self_improvement",
      "role": "skill_gap_repair",
      "canDo": ["capture missing routed roles as skill gap candidates", "record successful skill composition samples as proficiency evidence", "gate reusable lessons by scope/evidence/confidence"],
      "cannotDo": ["mutate global skills without approval", "promote unverified one-off noise", "store raw transcripts or secrets"],
      "triggers": ["skill", "proficiency", "self learning", "completion audit", "missing role", "repeated failure", "\u89c4\u5219\u5931\u6548", "\u4e0d\u8981\u53cd\u590d\u63d0\u9192"],
      "applyAt": ["reflection", "post_verification", "gap_repair", "before_completion"],
      "verification": ["candidate first", "validation gate", "missing_skill_role or skill_proficiency_success_sample evidence", "approval for mutation"]
    },
    {
      "name": "engineering evidence grounding",
      "category": "decision_quality",
      "role": "evidence_grounding",
      "canDo": ["separate FACT, INFERENCE, and UNKNOWN", "require named current evidence for facts", "let live evidence override memory and assumptions"],
      "cannotDo": ["promote plausible explanations to facts", "use stale memory as current proof", "hide critical unknowns"],
      "triggers": ["fix", "debug", "repair", "optimize", "architecture", "root cause", "best option", "optimal", "performance", "regression", "\u4fee\u590d", "\u4f18\u5316", "\u67b6\u6784", "\u6839\u56e0", "\u6700\u4f18", "\u6027\u80fd"],
      "applyAt": ["preflight", "diagnosis", "decision", "before_mutation", "before_completion"],
      "verification": ["every FACT has evidence", "INFERENCE and UNKNOWN remain explicit", "current evidence overrides stale memory"],
      "stopCondition": "task is a greeting, acknowledgement, simple factual answer, or tiny fully specified low-risk action"
    },
    {
      "name": "engineering-decision-gate",
      "category": "planning",
      "role": "engineering_decision",
      "canDo": ["define pain point, objective, and constraints", "compare feasible options and tradeoffs", "enforce dependency-ordered execution contracts and acceptance"],
      "cannotDo": ["claim universal optimality", "select an option without alternatives and criteria", "continue after failed step acceptance"],
      "triggers": ["fix", "debug", "repair", "optimization", "architecture", "design decision", "tradeoff", "best option", "optimal", "migration", "bottleneck", "\u4fee\u590d\u95ee\u9898", "\u4f18\u5316\u65b9\u6848", "\u67b6\u6784\u8bbe\u8ba1", "\u6700\u4f18\u65b9\u6848"],
      "applyAt": ["decision", "before_mutation", "execution", "before_completion"],
      "verification": ["engineering-decision-gate ok=true", "root-cause status and discriminating test are explicit", "each step has input/output/acceptance/stop conditions"],
      "stopCondition": "engineering judgment is not required by task complexity, risk, or decision content"
    },
    {
      "name": "spec-kit / world-model-method",
      "category": "planning",
      "role": "structured_decision",
      "canDo": ["turn vague ideas into spec/tasks", "compare routes", "preserve acceptance criteria"],
      "cannotDo": ["slow down tiny obvious fixes"],
      "triggers": ["ambiguous feature", "product idea", "architecture", "multi-phase", "\u9700\u6c42"],
      "applyAt": ["planning", "route_selection"],
      "verification": ["requirements have tasks or explicit non-goals"]
    },
    {
      "name": "browser-act",
      "category": "tool_execution",
      "role": "browser_operator",
      "canDo": ["open pages", "click/type/forms", "screenshots", "rendered page extraction", "visible verification checkbox workflows"],
      "cannotDo": ["hidden captcha solving", "credential/payment/sensitive submission without confirmation"],
      "triggers": ["browser", "\u7f51\u9875", "\u70b9\u51fb", "\u767b\u5f55\u6001", "\u622a\u56fe", "Cloudflare", "I am human", "real user path"],
      "applyAt": ["execution", "user_path_verification"],
      "verification": ["browser-act core skill loaded before first command", "visible result or screenshot evidence"]
    },
    {
      "name": "agent-bridge",
      "category": "coordination",
      "role": "controlled_agent_channel",
      "canDo": ["open/connect/send/wait channel", "handoff compact task packets", "failover/adopt advisory results"],
